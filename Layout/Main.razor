    #region Files

    private async Task onArchiveUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        // The file picker lists all files (see FileTreePanel), so the type is checked here.
        if (!ProjectArchive.IsSupported(file.Name))
        {
            errorMessage = $"\"{file.Name}\" isn't an archive the app can read. Use a .zip, .7z, .rar or .tar.gz of the project folder.";
            return;
        }

        if (file.Size > MaxArchiveSize)
        {
            errorMessage = "The archive is too large. The maximum size is 512 MB; leaving out bin and obj folders usually helps.";
            return;
        }

        await loadProjectAsync("Reading the archive...", "Could not read the archive", async _ =>
        {
            using var stream = file.OpenReadStream(maxAllowedSize: MaxArchiveSize);
            using var ms = new MemoryStream((int)file.Size);
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            return await ProjectArchive.ReadAsync(ms);
        });
    }

    private async Task onGitHubLoad(string url)
    {
        if (!GitHubRepository.TryParse(url, out var location) || location == null)
        {
            errorMessage = $"\"{url}\" isn't a GitHub repository address. Use one like https://github.com/owner/repository.";
            return;
        }

        await loadProjectAsync("Connecting to GitHub...", "Could not load the repository", progress =>
            GitHubRepository.ReadAsync(httpClient, location, progress));
    }

    // Shows the files from an archive or a repository in the file tree and the editor, then generates the diagram.
    private async Task loadProjectAsync(string message, string failureMessage, Func<IProgress<string>, Task<List<SourceFile>>> readFiles)
    {
        isUploading = true;
        loadingMessage = message;
        errorMessage = string.Empty;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var progress = new StatusProgress(text =>
            {
                loadingMessage = text;
                StateHasChanged();
            });
            var files = (await readFiles(progress))
                .Where(f => !string.IsNullOrWhiteSpace(f.Content))
                .Select(f => (File: f, IsIgnored: ProjectArchive.IsBuildOutputOrLibrary(f.Path)))
                .ToList();

            // Project files are only read for their root namespace, which Razor components use.
            var razorContext = RazorProjectContext.Build(files.Where(f => !f.IsIgnored).Select(f => f.File));

            // A new list (rather than clearing the old one) tells the file tree to rebuild.
            var entries = new List<ProjectFileEntry>();
            foreach (var (sourceFile, isIgnored) in files)
            {
                string content;
                if (RazorExtractor.IsRazorFile(sourceFile.Path))
                    content = RazorExtractor.Extract(sourceFile.Content, sourceFile.Path, razorContext);
                else if (sourceFile.Path.EndsWith(".cs", StringComparison.OrdinalIgnoreCase) || JavaScriptAnalyzer.IsJavaScriptFile(sourceFile.Path))
                    content = sourceFile.Content;
                else
                    continue;

                if (string.IsNullOrWhiteSpace(content))
                    continue;

                entries.Add(new ProjectFileEntry
                {
                    FullPath = sourceFile.Path,
                    Content = content,
                    IsSelected = !isIgnored
                });
            }

            // The current project stays, rather than being replaced by an empty one.
            if (entries.Count == 0)
            {
                errorMessage = "There's no code in the project's files.";
                return;
            }

            projectFiles = entries;
            await rebuildSourceFromSelection();
        }
        catch (InvalidDataException ex)
        {
            // ProjectArchive's and GitHubRepository's messages are written for the user.
            errorMessage = ex.Message;
            return;
        }
        catch (Exception ex)
        {
            errorMessage = $"{failureMessage}: {ex.Message}";
            return;
        }
        finally
        {
            isUploading = false;
        }

        await generateCoreAsync(pickViewBySize: true);
    }

    private async Task onSelectionChanged()
    {
        await rebuildSourceFromSelection();
        await scheduleGenerateAsync();
    }

    private async Task rebuildSourceFromSelection()
    {
        sourceCode = SourceBundle.Join(projectFiles.Where(f => f.IsSelected).Select(f => new SourceFile(f.FullPath, f.Content)));
        await jsRuntime.InvokeVoidAsync("SetMonacoContent", sourceCode);
    }

    #endregion


    public async ValueTask DisposeAsync()
    {
        generationCts?.Cancel();
        debounceCts?.Cancel();

        try
        {
            await jsRuntime.InvokeVoidAsync("CodeGraphView.dispose");
            await jsRuntime.InvokeVoidAsync("DisposeMonaco");
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; nothing to clean up on the JS side.
        }

        selfReference?.Dispose();
    }
