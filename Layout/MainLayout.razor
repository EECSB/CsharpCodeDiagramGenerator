@inherits LayoutComponentBase
<div class="page">
    <main>
        <div class="top-row px-4" style="justify-content: space-between; background-color: #f25958;">
            <div style="margin-left: 2em;">
                <h1 style="margin: 0; font-size: 1.8em; font-weight: bold; color: white;">
                    C# Code Diagram Generator
                </h1>
            </div>

            <div>
                <div @onclick="() => { aboutComponent.Show = !aboutComponent.Show; showShare = false; }" style="font-size: 1.3em; color: white; font-weight: bold; cursor: pointer; margin-right: 4em;">
                    About
                </div>
            </div>
        </div>

        <article class="content px-4">
            <Main></Main>
            <About @ref="aboutComponent" />
        </article>
    </main>
</div>

@code {
    private About aboutComponent;
    private bool showShare = false;
}