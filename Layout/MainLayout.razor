@inherits LayoutComponentBase
<div class="page">
    <header class="app-header">
        <h1><Icon Name="network" Size="22" />C# Code Diagram Generator</h1>
        <button class="about-button" @onclick="() => showAbout = !showAbout"><Icon Name="info" />About</button>
    </header>

    <main class="app-main">
        <Main></Main>
    </main>

    <About @bind-Show="showAbout" />
</div>

@code {
    private bool showAbout;
}
